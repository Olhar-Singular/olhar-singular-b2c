# ╔═══════════════════════════════════════════════════════════════════╗
# ║  .env ÚNICO — serve o app (Vite) E as edge functions (make fn-serve)  ║
# ╚═══════════════════════════════════════════════════════════════════╝
# Copie para .env (`cp .env.example .env`) e preencha. Nunca commite o .env.

# ─── Supabase ───
# Remoto/produção: pegue no dashboard do projeto.
# Local (`make sb-start`): use os valores de `make sb-status` (URL http://localhost:54321 + anon key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Acesso direto ao Postgres remoto (opcional — fora do client supabase-js)
# DATABASE_PASSWORD=
# DATABASE_URL=

# ─── Segredos de backend (edge functions) — SEM prefixo VITE_ (não vão pro bundle) ───
# Chave da IA — Google AI Studio (gratuito — gere em https://aistudio.google.com/apikey)
AI_API_KEY=
# Opcional, só dev local: força um modelo específico (nome já resolvido, ex.
# "gemini-2.5-flash") para TODAS as chamadas de IA, ignorando o MODEL_MAP —
# útil quando a AI_API_KEY em uso não tem acesso ao gemini-2.5-pro padrão.
# Deixe vazio/comentado em produção.
# AI_MODEL_OVERRIDE=

# Login com Google (Supabase LOCAL). Lidos por config.toml via env(...).
# Crie um OAuth client (Web) no Google Cloud Console e aponte o redirect URI local para
# http://127.0.0.1:54321/auth/v1/callback. Em produção, o provider é habilitado no Dashboard
# (Auth → Providers → Google), não por estas vars.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Mercado Pago (Pix e cartão inline; único provedor de pagamento) ───
# Access Token de PRODUÇÃO da aplicação (APP_USR-...), com Checkout API habilitado.
# Usado por create-pix-payment, create-card-payment, subscribe, cancel-subscription,
# update-subscription-card e mp-webhook (o webhook precisa ter os tópicos
# "Pagamentos" e "Planos e assinaturas" marcados no painel do MP).
ACCESS_TOKEN_MP_PROD=
# URL pública do app (sem barra final): back_url da assinatura no MP e redirectTo
# do convite. Produção: https://professor.olharsingular.com. Local: http://localhost:8080.
APP_URL=
# Segredo do HMAC de e-mail/IP em checkout_attempts (rate limit do /assinar).
# Qualquer string longa e aleatória; sem ela a função usa a service key.
CHECKOUT_HASH_SECRET=
# Assinatura secreta do webhook (painel do MP > Webhooks), valida o header x-signature.
VERIFY_TOKEN_MP_PROD=
# Public Key de PRODUÇÃO da MESMA aplicação do ACCESS_TOKEN_MP_PROD (par obrigatório:
# token de uma app + public key de outra gera "invalid card token"). Vai pro bundle
# (prefixo VITE_) e inicializa o Card Payment Brick no browser. Em produção: Vercel
# (Production + Preview) e GitHub Secrets do build.
VITE_MP_PUBLIC_KEY=

# ─── Analytics (tudo opcional: sem os IDs nada é injetado nem enviado) ───
# Container do GTM (GTM-XXXX). Injetado em runtime pelo app, nunca em /assinar
# nem em /definir-senha. GA4 e Meta Pixel são configurados dentro do GTM.
VITE_GTM_ID=
# Eventos server-side (edge functions): GA4 Measurement Protocol e Meta CAPI.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CAPI_TOKEN=

# STAGING: credenciais do USUÁRIO DE TESTE vendedor (também APP_USR-...) e do
# comprador de teste. `make fn-serve-mp-test` remapeia estas para os nomes acima
# num env efêmero, para desenvolver cartão sem cobrar de verdade (o sandbox não
# tem Pix). Nunca misture TEST no front com PROD no back.
ACCESS_TOKEN_MP=
PUBLIC_KEY_MP=
VERIFY_TOKEN_MP=
USER_TEST_ID_MP=
PASSWORD_TEST_MP=
