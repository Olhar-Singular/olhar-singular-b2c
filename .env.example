# ╔═══════════════════════════════════════════════════════════════════╗
# ║  .env ÚNICO — serve o app (Vite) E as edge functions (make fn-serve)  ║
# ╚═══════════════════════════════════════════════════════════════════╝
# Copie para .env (`cp .env.example .env`) e preencha. Nunca commite o .env.

# ─── Supabase ───
# Remoto/produção: pegue no dashboard do projeto.
# Local (`make sb-start`): use os valores de `make sb-status` (URL http://localhost:54321 + anon key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Acesso direto ao Postgres remoto (opcional — fora do client supabase-js)
# DATABASE_PASSWORD=
# DATABASE_URL=

# ─── Segredos de backend (edge functions) — SEM prefixo VITE_ (não vão pro bundle) ───
# Chave da IA — Google AI Studio (gratuito — gere em https://aistudio.google.com/apikey)
AI_API_KEY=

# Login com Google (Supabase LOCAL). Lidos por config.toml via env(...).
# Crie um OAuth client (Web) no Google Cloud Console e aponte o redirect URI local para
# http://127.0.0.1:54321/auth/v1/callback. Em produção, o provider é habilitado no Dashboard
# (Auth → Providers → Google), não por estas vars.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (cartão): create-stripe-checkout e stripe-webhook.
# Modo de teste: use a Secret key (sk_test_...) do dashboard.
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) gerado por `stripe listen` ou no dashboard de webhooks.
STRIPE_WEBHOOK_SECRET=

# Mercado Pago (Pix): create-pix-payment e mp-webhook.
# Access Token de PRODUÇÃO da aplicação (APP_USR-...), com pagamento direto
# habilitado na conta. É o único que o /v1/payments aceita (o token antigo
# responde "Unauthorized use of live credentials").
ACCESS_TOKEN_MP_PROD=
# Assinatura secreta do webhook (gerada no painel do MP ao cadastrar o webhook),
# usada para validar o header x-signature. Sem ela, o mp-webhook não valida.
VERIFY_TOKEN_MP_PROD=
